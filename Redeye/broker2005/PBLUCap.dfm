  object GetDetsSQL: TFDQuery
    ConnectionName = 'PB'
    SQL.Strings = (
      'Select  Capability.Capability,'
      '        Capability.Description'
      'From Capability'
      'Where (Capability.Description Like :Code_From)'
      'Order By Capability.Description')
